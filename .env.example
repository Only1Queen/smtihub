# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && chmod 600 .env

# --- Django ---------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=kljkjdbjvibelvbvkvlvbvjlwjbwldjwbdwljbdkjhvblkvdbvwdbliuvblkjvbisjdbk;jvbohbkdvbjhvfjv
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=smti-hub.internal
DJANGO_TIME_ZONE=Africa/Lagos

# --- PostgreSQL -----------------------------------------------------------
# Two roles: smti_owner runs migrations, smti_web is what the app connects as.
# Generate each: python -c "import secrets; print(secrets.token_urlsafe(24))"
#
# Use that generator and nothing else. These two go into DATABASE_URL, and a
# hand-picked password with punctuation in it fails in ways that look like
# anything but a password problem: Compose truncates the value at ';', and
# urlparse returns None for the password if it contains '/' or '#'. Either way
# the app sends something shorter than what you set, the database rejects it,
# and every page returns 500. token_urlsafe emits only [A-Za-z0-9_-], which
# survives both.
POSTGRES_DB=smti
POSTGRES_OWNER=smti_owner
POSTGRES_OWNER_PASSWORD=replace-me-with-generated-value
POSTGRES_WEB_USER=smti_web
POSTGRES_WEB_PASSWORD=replace-me-with-generated-value

# --- Active Directory -----------------------------------------------------
# Leave AUTH_LDAP_SERVER_URI blank to use local accounts only. When it is set,
# AD is the source of truth for who can sign in and who is a manager.
# Use ldaps:// (636). If the DC only offers ldap:// (389), StartTLS is turned on
# automatically — plain 389 with no TLS sends the password in clear text.
AUTH_LDAP_SERVER_URI=
# Read-only service account. It needs no privileges beyond reading users and groups.
AUTH_LDAP_BIND_DN=CN=svc-smti-hub,OU=Service Accounts,DC=corp,DC=example
AUTH_LDAP_BIND_PASSWORD=
AUTH_LDAP_USER_SEARCH_BASE=OU=Users,DC=corp,DC=example
AUTH_LDAP_GROUP_SEARCH_BASE=OU=Groups,DC=corp,DC=example
# Members of this group get the manager role. Membership is re-checked at every
# sign-in, so removing someone in AD removes it here.
AUTH_LDAP_MANAGER_GROUP_DN=CN=SMTI-Managers,OU=Groups,DC=corp,DC=example
# Optional: if set, only members of this group may sign in at all.
AUTH_LDAP_ACCESS_GROUP_DN=
# Set to DEBUG while first connecting — bind and group-search failures are the
# whole diagnosis, and they are silent at the default level.
LDAP_LOG_LEVEL=WARNING

# --- Login lockout --------------------------------------------------------
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Error mail -----------------------------------------------------------
# Who gets the traceback when a page 500s. Blank means nobody does.
DJANGO_ADMINS=SMTI Manager <manager@organisation.example>
SERVER_EMAIL=smti-hub@organisation.example

# --- Email ----------------------------------------------------------------
# Leave EMAIL_HOST blank to print mail to the log instead of sending.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=smti-hub@organisation.example

# --- Backups --------------------------------------------------------------
# Every backup is encrypted with this. `./deploy.sh` generates one on the first
# run if it is missing and prints it once — keep a copy somewhere other than
# this host, because a backup you cannot decrypt is not a backup.
BACKUP_PASSPHRASE=
